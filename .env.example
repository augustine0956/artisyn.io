# Sentry configuration (do NOT commit real secrets)
# Public DSN for client-side errors
NEXT_PUBLIC_SENTRY_DSN=

# Private DSN for server-side (optional if using public DSN)
SENTRY_DSN=

# Sentry auth token for CLI (set as repo secret in CI)
SENTRY_AUTH_TOKEN=

# Sentry organization and project (for CI)
SENTRY_ORG=
SENTRY_PROJECT=

# Release identifier used when uploading source maps (set in CI)
SENTRY_RELEASE=

# Optional sampling rate for performance traces (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.02
